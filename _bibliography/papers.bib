@article{shao2025dtrec,
  abbr={arXiv},
  title={DTRec: Learning Dynamic Reasoning Trajectories for Sequential Recommendation},
  author={Shao, Yifan and Zhou, Peilin and Wang, Shoujin and Zhang, Weizhi and Cai, Xu and Kim, Sunghun},
  journal={arXiv preprint arXiv:2512.14036},
  year={2025},
  url={https://arxiv.org/abs/2512.14036},
  html={https://arxiv.org/abs/2512.14036},
  abstract={Sequential recommendation aims to predict the next item a user will interact with based on their historical interaction sequences. While recent approaches leveraging large language models (LLMs) have shown promising results, they often rely on static reasoning patterns that may not adapt well to the dynamic nature of user preferences. In this work, we propose DTRec, a novel framework that learns dynamic reasoning trajectories for sequential recommendation. Our approach enables the model to adaptively generate reasoning paths that evolve with user interaction sequences, capturing both short-term interests and long-term preference shifts.},
  bibtex_show={true},
  selected={true},
}

@inproceedings{shao2024negative,
  abbr={ICIC},
  title={Negative Samples Selection Can Improve Graph Contrastive Learning in Collaborative Filtering},
  author={Shao, Yifan and Cai, Xu and Gu, Fangming and Li, Ximing},
  booktitle={International Conference on Intelligent Computing (ICIC)},
  pages={456--467},
  year={2024},
  publisher={Springer Nature Singapore},
  url={https://link.springer.com/chapter/10.1007/978-981-97-5618-6_38},
  html={https://link.springer.com/chapter/10.1007/978-981-97-5618-6_38},
  abstract={Graph contrastive learning has emerged as a powerful paradigm for collaborative filtering in recommender systems. However, the selection of negative samples plays a crucial role in the effectiveness of contrastive learning. In this work, we investigate how the choice of negative samples affects the performance of graph contrastive learning for collaborative filtering. We propose a principled negative sample selection strategy that significantly improves recommendation quality by carefully selecting informative and challenging negative examples during training.},
  bibtex_show={true},
  selected={true},
}
